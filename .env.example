DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/workforceiq
SECRET_KEY=replace-with-output-of-python3-c-"import secrets;print(secrets.token_hex(32))"
# development locally; MUST be "production" on the deployed backend (Render) —
# this switches auth cookies to Secure + SameSite=None, required for the
# frontend (Vercel) and backend (Render) living on different domains.
ENV=development
# Comma-separated list of exact frontend origins allowed to call this API.
# Add your deployed Vercel URL here in production, e.g.:
# CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
SEED_ADMIN_EMAIL=admin@workforceiq.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
SEED_MANAGER_PASSWORD=replace-with-a-strong-password
HR_DATA_CSV_PATH=../datasets/hr_employee_data.csv
VITE_API_TARGET=http://127.0.0.1:8000
MCP_SERVER_PORT=8001
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# Frontend-only (set in Vercel's dashboard, not read by the backend):
# absolute URL of the deployed backend, no trailing slash, e.g.:
# VITE_API_BASE_URL=https://workforceiq-backend.onrender.com
